{
  "identifier": "viewer",
  "description": "Independent local image viewer and explicit export dialog",
  "windows": ["viewer-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
