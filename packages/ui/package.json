    "solid-js": "^1.9.7"
  },
  "devDependencies": {
    "@tabler/icons": "3.51.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.2.4"
  }
